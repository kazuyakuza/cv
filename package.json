{
  "name": "career-diorama",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "svg:generate": "node scripts/generate-geometry.mjs",
    "svg:assemble": "node scripts/assemble-svg.mjs",
    "svg:optimize": "svgo -r -f src/svg -o generated/svg"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.6.0",
    "qrcode": "^1.5.4",
    "svgo": "^4.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
